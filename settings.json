{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "ask": [
      "Bash(az *)"
    ],
    "deny": [
      "Bash(chmod -R *)",
      "Bash(chown -R *)",
      "Bash(dd *)",
      "Bash(git branch -D *)",
      "Bash(git clean -df*)",
      "Bash(git clean -dxf*)",
      "Bash(git clean -f*)",
      "Bash(git clean -xdf*)",
      "Bash(git clean -xf*)",
      "Bash(git push * --force *)",
      "Bash(git push * --force)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push --force *)",
      "Bash(git push --force)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(git reset * --hard*)",
      "Bash(git reset --hard*)",
      "Bash(mkfs*)",
      "Bash(rm --recursive *)",
      "Bash(rm -R *)",
      "Bash(rm -Rf *)",
      "Bash(rm -f -r *)",
      "Bash(rm -fR *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -r -f *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(sudo)",
      "Bash(terraform apply * -destroy*)",
      "Bash(terraform apply -destroy*)",
      "Bash(terraform destroy *)",
      "Bash(terraform destroy)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "lot-map@lot-map": true
  },
  "extraKnownMarketplaces": {
    "lot-map": {
      "source": {
        "source": "github",
        "repo": "alexeyw/lot-map"
      }
    }
  },
  "outputStyle": "Terse",
  "pluginConfigs": {
    "lot-map@lot-map": {
      "options": {
        "language": "en",
        "hookRecords": false,
        "hookReasons": false,
        "guardedHooks": true,
        "subagentNames": true,
        "contextCost": false,
        "theme": "auto",
        "background": "solid",
        "layout": "you-top",
        "motion": "full",
        "textSize": "footnote",
        "terminalView": "braille"
      }
    }
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "auto",
  "switchModelsOnFlag": true,
  "effortLevel": "high"
}
