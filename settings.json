{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "ask": [
      "Bash(az:*)",
      "Bash(gh:*)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "lot-map@lot-map": true
  },
  "extraKnownMarketplaces": {
    "dotnet-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/dotnet/skills.git"
      }
    },
    "lot-map": {
      "source": {
        "source": "github",
        "repo": "alexeyw/lot-map"
      }
    }
  },
  "outputStyle": "Terse",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "lot-map@lot-map": {
      "options": {
        "language": "en",
        "hookRecords": false,
        "hookReasons": false,
        "guardedHooks": true,
        "subagentNames": true,
        "contextCost": false,
        "theme": "auto",
        "background": "solid",
        "layout": "you-top",
        "motion": "full",
        "textSize": "footnote",
        "terminalView": "braille"
      }
    }
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "switchModelsOnFlag": true,
  "voiceEnabled": true,
  "effortLevel": "high"
}
